{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "CompOS Installer",
  "version": "0.1.0",
  "identifier": "com.compos.installer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' data: blob: filesystem: tauri: asset:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: filesystem: https:; connect-src 'self' ipc: http://ipc.localhost tauri:;"
    },
    "windows": [
      {
        "title": "CompOS Installer",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "static/images/minimal-preview.png"
    ]
  }
}
